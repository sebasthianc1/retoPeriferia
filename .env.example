# Proveedor del modelo de lenguaje. Por ahora solo "anthropic" está implementado.
LLM_PROVIDER=anthropic

# Clave del proveedor elegido. NUNCA se versiona, nunca aparece en el front ni en logs.
ANTHROPIC_API_KEY=

# Modelo a usar.
LLM_MODEL=claude-sonnet-5-5

# Puerto del backend (sirve también el front estático en web/).
PORT=3000

# Tope de iteraciones herramienta -> modelo por turno (CA1).
MAX_TOOL_ITERATIONS=25

# Tope de tokens de salida por llamada al modelo (control de costo).
MAX_OUTPUT_TOKENS=4096

# Clave de acceso opcional para proteger el link público. Vacío = sin protección.
ACCESS_KEY=
